# Shared look for the README recordings (sourced by the other tapes).
Set Shell bash
Set FontFamily "JetBrains Mono"
Set FontSize 15
Set Theme "Catppuccin Mocha"
Set Padding 18
Set Margin 0
Set TypingSpeed 45ms
Hide
Type "export SUBS_DEMO=1 PATH=$PWD/target/release:$PATH PS1='\[\e[36m\]$\[\e[0m\] ' && clear"
Enter
Show
