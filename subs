#!/usr/bin/env python3
"""subs - see and switch ChatGPT/Codex and Claude subscription logins.

    subs                          status of every account
    subs tui                      interactive view
    subs login codex|claude [EMAIL] [--use]
    subs use   codex|claude EMAIL
    subs add   codex|claude EMAIL store the login's email + password
    subs pass  codex|claude EMAIL copy (or print) the stored password
    subs rm    codex|claude EMAIL
    subs json                     status as JSON

Python 3 stdlib only. State lives in $SUBS_HOME
(default ${XDG_DATA_HOME:-~/.local/share}/subs), mode 0700:

    accounts.json        {provider: {email: {"password": ...}}}
    codex/EMAIL.json     a saved ~/.codex/auth.json
    claude/EMAIL.json    a saved Claude credential + oauthAccount

Logins run in a throwaway CODEX_HOME / CLAUDE_CONFIG_DIR, so signing in to
a new account never touches - or revokes - the one in use. `use` swaps the
saved credential in, saving the current one first. Tokens are never
refreshed here: a refresh rotates the token and kills every other copy, so
that stays the job of the real CLI, which runs against the live file.
"""

import base64
import curses
import getpass
import json
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from concurrent.futures import ThreadPoolExecutor

HOME = os.path.expanduser("~")
STORE = os.environ.get("SUBS_HOME") or os.path.join(
    os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local", "share"), "subs")
DARWIN = sys.platform == "darwin"
TIMEOUT = 15


# --- files -----------------------------------------------------------------

def rjson(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def wjson(path, obj):
    d = os.path.dirname(path)
    os.makedirs(d, mode=0o700, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".subs-")  # created 0600
    with os.fdopen(fd, "w") as f:
        json.dump(obj, f, indent=2)
    os.replace(tmp, path)


def jwt(token):
    try:
        p = token.split(".")[1]
        return json.loads(base64.urlsafe_b64decode(p + "=" * (-len(p) % 4)))
    except (AttributeError, IndexError, ValueError):
        return {}


def get(url, headers):
    req = urllib.request.Request(url, headers={"User-Agent": "subs/1", **headers})
    with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
        return json.load(r)


def accounts():
    return rjson(os.path.join(STORE, "accounts.json")) or {}


def save_accounts(a):
    wjson(os.path.join(STORE, "accounts.json"), a)


def snap_path(prov, email):
    return os.path.join(STORE, prov.name, email + ".json")


def snaps(prov):
    d = os.path.join(STORE, prov.name)
    try:
        return [f[:-5] for f in os.listdir(d) if f.endswith(".json")]
    except OSError:
        return []


# --- providers -------------------------------------------------------------
#
# A provider reads/writes its live credential "blob", names the account in it
# and asks the provider - not the token - what the plan and usage are.

class Codex:
    name = "codex"

    def home(self):
        return os.environ.get("CODEX_HOME") or os.path.join(HOME, ".codex")

    def read(self, home=None):
        return rjson(os.path.join(home or self.home(), "auth.json"))

    def write(self, blob):
        wjson(os.path.join(self.home(), "auth.json"), blob)

    def email(self, blob):
        return jwt(((blob or {}).get("tokens") or {}).get("id_token")).get("email")

    def expires(self, blob):
        return jwt(blob["tokens"].get("access_token")).get("exp")

    def login(self, email, home):
        env = dict(os.environ, CODEX_HOME=home)
        return subprocess.call(["codex", "login", "-c", 'cli_auth_credentials_store="file"',
                                "--device-auth"], env=env)

    def usage(self, blob):
        t = blob["tokens"]
        u = get("https://chatgpt.com/backend-api/wham/usage",
                {"Authorization": "Bearer " + t["access_token"],
                 "ChatGPT-Account-Id": t.get("account_id", "")})
        rl = u.get("rate_limit") or {}
        wins = []
        for k in ("primary_window", "secondary_window"):
            w = rl.get(k)
            if w:
                wins.append((span(w.get("limit_window_seconds")), w.get("used_percent"),
                             w.get("reset_at")))
        cr = u.get("credits") or {}
        extra = None
        if cr.get("unlimited"):
            extra = "credits unlimited"
        elif cr.get("has_credits"):
            extra = "credits %.0f" % float(cr.get("balance") or 0)
        return {"plan": u.get("plan_type"), "windows": wins,
                "resets": (u.get("rate_limit_reset_credits") or {}).get("available_count"),
                "extra": extra, "limited": bool(rl.get("limit_reached"))}


class Claude:
    name = "claude"
    keychain = "Claude Code-credentials"

    def cfg(self):
        return os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(HOME, ".claude")

    def state(self, cfg=None):
        # ~/.claude.json, or $CLAUDE_CONFIG_DIR/.claude.json when that is set
        if cfg or os.environ.get("CLAUDE_CONFIG_DIR"):
            return os.path.join(cfg or self.cfg(), ".claude.json")
        return os.path.join(HOME, ".claude.json")

    def mac_keychain(self, cfg):
        return DARWIN and not cfg and not os.environ.get("CLAUDE_CONFIG_DIR")

    def read(self, cfg=None):
        if self.mac_keychain(cfg):
            r = subprocess.run(["security", "find-generic-password", "-s", self.keychain, "-w"],
                               capture_output=True, text=True)
            cred = json.loads(r.stdout) if r.returncode == 0 else None
        else:
            cred = rjson(os.path.join(cfg or self.cfg(), ".credentials.json"))
        if not cred:
            return None
        acct = (rjson(self.state(cfg)) or {}).get("oauthAccount")
        if not acct and cfg:  # a fresh login may not have written it yet
            acct = self.profile(cred)
        return {"credentials": cred, "account": acct}

    def profile(self, cred):
        try:
            p = get("https://api.anthropic.com/api/oauth/profile",
                    {"Authorization": "Bearer " + cred["claudeAiOauth"]["accessToken"],
                     "anthropic-beta": "oauth-2025-04-20"})
        except (urllib.error.URLError, OSError, ValueError, KeyError):
            return None
        a, o = p.get("account") or {}, p.get("organization") or {}
        return {"accountUuid": a.get("uuid"), "emailAddress": a.get("email"),
                "displayName": a.get("display_name"), "organizationUuid": o.get("uuid"),
                "organizationName": o.get("name"), "billingType": o.get("billing_type")}

    def write(self, blob):
        if self.mac_keychain(None):
            subprocess.run(["security", "add-generic-password", "-U", "-a", getpass.getuser(),
                            "-s", self.keychain, "-w", json.dumps(blob["credentials"])],
                           check=True)
        else:
            wjson(os.path.join(self.cfg(), ".credentials.json"), blob["credentials"])
        st = rjson(self.state()) or {}
        st["oauthAccount"] = blob.get("account")
        wjson(self.state(), st)

    def email(self, blob):
        return ((blob or {}).get("account") or {}).get("emailAddress")

    def expires(self, blob):
        ms = (blob["credentials"].get("claudeAiOauth") or {}).get("expiresAt")
        return ms / 1000 if ms else None

    def login(self, email, cfg):
        env = dict(os.environ)
        if cfg:
            env["CLAUDE_CONFIG_DIR"] = cfg
        return subprocess.call(["claude", "auth", "login"] + (["--email", email] if email else []),
                               env=env)

    def usage(self, blob):
        o = blob["credentials"].get("claudeAiOauth") or {}
        u = get("https://api.anthropic.com/api/oauth/usage",
                {"Authorization": "Bearer " + o["accessToken"],
                 "anthropic-beta": "oauth-2025-04-20"})
        wins = [(lbl, (u.get(k) or {}).get("utilization"), iso((u.get(k) or {}).get("resets_at")))
                for k, lbl in (("five_hour", "5h"), ("seven_day", "7d")) if u.get(k)]
        x = u.get("extra_usage") or {}
        extra = None
        if x.get("is_enabled"):
            extra = "extra %.0f/%.0f %s" % (x.get("used_credits") or 0, x.get("monthly_limit") or 0,
                                            x.get("currency") or "")
        tier = o.get("rateLimitTier") or ""
        plan = (o.get("subscriptionType") or "?") + next(
            (m for m in ("20x", "5x") if tier.endswith(m)), "")
        return {"plan": plan, "windows": wins, "resets": None, "extra": extra,
                "limited": any((w[1] or 0) >= 100 for w in wins)}


PROVIDERS = {"codex": Codex(), "claude": Claude()}


def span(sec):
    if not sec:
        return "?"
    if sec % 86400 == 0:
        return "%dd" % (sec // 86400)
    return "%dh" % round(sec / 3600)


def iso(s):
    if not s:
        return None
    from datetime import datetime
    return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()


# --- status ----------------------------------------------------------------

def fetch(prov, blob, active):
    exp = prov.expires(blob)
    if exp and exp < time.time():
        return {"err": "token expired - " + ("run %s to refresh" % prov.name if active
                                             else "refreshes once in use")}
    try:
        return prov.usage(blob)
    except urllib.error.HTTPError as e:
        return {"err": "auth rejected (%d)" % e.code if e.code in (401, 403)
                else "http %d" % e.code}
    except (urllib.error.URLError, OSError, ValueError, KeyError) as e:
        return {"err": str(getattr(e, "reason", e))[:40]}


def status():
    """One row per known account; the live one is re-saved so its copy stays current."""
    acc, rows = accounts(), []
    for prov in PROVIDERS.values():
        live = prov.read()
        cur = prov.email(live)
        if cur:
            wjson(snap_path(prov, cur), live)
        for email in sorted(set(snaps(prov)) | set(acc.get(prov.name, {})) | {cur} - {None}):
            blob = live if email == cur else rjson(snap_path(prov, email))
            rows.append({"provider": prov.name, "email": email, "active": email == cur,
                         "password": bool(acc.get(prov.name, {}).get(email, {}).get("password")),
                         "blob": blob})
    with ThreadPoolExecutor(8) as ex:
        res = list(ex.map(lambda r: fetch(PROVIDERS[r["provider"]], r["blob"], r["active"])
                          if r["blob"] else {"err": "not logged in"}, rows))
    for r, u in zip(rows, res):
        del r["blob"]
        r.update(u)
    return rows


def dur(t):
    if t is None:
        return "-"
    s = max(0, int(t - time.time()))
    if s >= 86400:
        return "%.1fd" % (s / 86400)
    if s >= 3600:
        return "%dh%02dm" % (s // 3600, s % 3600 // 60)
    return "%dm" % (s // 60)


def cells(r):
    """The row as fixed-order text cells; the CLI and the TUI both lay these out."""
    mark = "*" if r["active"] else " "
    if r.get("err"):
        return [mark, r["email"], "", r["err"]]
    wins = "  ".join("%-3s %3.0f%% %6s" % (lbl, pct or 0, dur(at))
                     for lbl, pct, at in r["windows"])
    tail = []
    if r.get("resets") is not None:
        tail.append("resets %d" % r["resets"])
    if r.get("extra"):
        tail.append(r["extra"])
    if r.get("limited"):
        tail.append("LIMITED")
    return [mark, r["email"], r.get("plan") or "?", wins + ("   " + "  ".join(tail) if tail else "")]


def table(rows):
    """Lines grouped by provider; returns (lines, row-index-or-None per line)."""
    w = [max([len(cells(r)[i]) for r in rows] + [1]) for i in range(3)]
    out, idx = [], []
    for name in PROVIDERS:
        out.append(name)
        idx.append(None)
        for i, r in enumerate(rows):
            if r["provider"] == name:
                c = cells(r)
                out.append("%s %-*s  %-*s  %s" % (c[0], w[1], c[1], w[2], c[2], c[3]))
                idx.append(i)
        if not any(r["provider"] == name for r in rows):
            out.append("  (none - subs login %s)" % name)
            idx.append(None)
    return out, idx


def cmd_status(_):
    rows = status()
    color = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
    for line, i in zip(*table(rows)):
        if color and i is None:
            line = "\033[2m" + line + "\033[0m"
        elif color and rows[i]["active"]:
            line = "\033[1m" + line + "\033[0m"
        print(line)


def cmd_json(_):
    print(json.dumps(status(), indent=2))


# --- actions ---------------------------------------------------------------

def running(name):
    r = subprocess.run(["pgrep", "-x", name], capture_output=True, text=True)
    return len(r.stdout.split())


def use(prov, email):
    blob = rjson(snap_path(prov, email))
    if not blob:
        sys.exit("subs: no saved %s login for %s - run: subs login %s %s"
                 % (prov.name, email, prov.name, email))
    live = prov.read()
    cur = prov.email(live)
    if cur == email:
        return print("%s: %s is already active" % (prov.name, email))
    if cur:
        wjson(snap_path(prov, cur), live)
    prov.write(blob)
    print("%s: %s -> %s" % (prov.name, cur or "-", email))
    n = running(prov.name)
    if n:
        print("%s: %d running %s process(es) still hold %s - restart them"
              % (prov.name, n, prov.name, cur or "the old login"))


def clip(text):
    for c in (["wl-copy"], ["xclip", "-selection", "clipboard"], ["pbcopy"]):
        if shutil.which(c[0]) and (c[0] != "wl-copy" or os.environ.get("WAYLAND_DISPLAY")) \
                and (c[0] != "xclip" or os.environ.get("DISPLAY")):
            subprocess.run(c, input=text, text=True)
            return True
    return False


def password(prov, email):
    return accounts().get(prov.name, {}).get(email, {}).get("password")


def show_password(prov, email):
    pw = password(prov, email)
    if not pw:
        return print("%s: no password stored for %s (subs add %s %s)"
                     % (prov.name, email, prov.name, email))
    if clip(pw):
        print("%s: password for %s copied to clipboard" % (prov.name, email))
    else:
        print("%s: password for %s: %s" % (prov.name, email, pw))


def login(prov, email=None, activate=False):
    if email and not password(prov, email) and sys.stdin.isatty():
        pw = getpass.getpass("password for %s %s (enter to skip): " % (prov.name, email))
        if pw:
            store_password(prov, email, pw)
    if email:
        show_password(prov, email)
    d = os.path.join(STORE, prov.name)
    os.makedirs(d, mode=0o700, exist_ok=True)
    for f in os.listdir(d):  # left by a login that was killed hard
        if f.startswith(".login-") and os.path.getmtime(os.path.join(d, f)) < time.time() - 3600:
            shutil.rmtree(os.path.join(d, f), ignore_errors=True)
    # macOS keeps the default Claude login in the keychain under a name tied to
    # the config dir, so there it signs in in place and puts the old one back.
    inplace = prov.name == "claude" and DARWIN and not os.environ.get("CLAUDE_CONFIG_DIR")
    tmp = None if inplace else tempfile.mkdtemp(prefix=".login-", dir=os.path.join(STORE, prov.name))
    before = prov.read()
    try:
        rc = prov.login(email, tmp)
        blob = prov.read(tmp)
        got = prov.email(blob)
        if rc != 0 or not got:
            sys.exit("subs: %s login failed" % prov.name)
    finally:
        if tmp:
            shutil.rmtree(tmp, ignore_errors=True)
    if email and got != email:
        print("subs: signed in as %s, not %s - saved under %s" % (got, email, got))
    wjson(snap_path(prov, got), blob)
    print("%s: saved %s" % (prov.name, got))
    if inplace and not activate and before and prov.email(before) != got:
        prov.write(before)
    if activate:
        if inplace:
            print("%s: %s is active" % (prov.name, got))
        else:
            use(prov, got)


def add(prov, email):
    if sys.stdin.isatty():
        pw = getpass.getpass("password for %s %s: " % (prov.name, email))
    else:
        pw = sys.stdin.readline().rstrip("\n")
    if not pw:
        sys.exit("subs: empty password, nothing stored")
    store_password(prov, email, pw)
    print("%s: stored password for %s" % (prov.name, email))


def store_password(prov, email, pw):
    a = accounts()
    a.setdefault(prov.name, {}).setdefault(email, {})["password"] = pw
    save_accounts(a)


def rm(prov, email, say=print):
    a = accounts()
    a.get(prov.name, {}).pop(email, None)
    save_accounts(a)
    try:
        os.remove(snap_path(prov, email))
    except OSError:
        pass
    say("%s: forgot %s" % (prov.name, email))


# --- tui -------------------------------------------------------------------

HELP = "enter use  l login  n new  a password  p copy  d delete  r refresh  q quit"


def tui(scr):
    curses.use_default_colors()
    curses.curs_set(0)
    for i, c in enumerate((curses.COLOR_GREEN, curses.COLOR_YELLOW, curses.COLOR_RED), 1):
        curses.init_pair(i, c, -1)
    rows, sel, msg = None, 0, ""

    def ask(prompt, secret=False):
        h, w = scr.getmaxyx()
        scr.move(h - 1, 0)
        scr.clrtoeol()
        scr.addstr(h - 1, 0, prompt[:w - 1])
        curses.curs_set(1)
        if not secret:
            curses.echo()
        s = scr.getstr(h - 1, min(len(prompt), w - 2), 200).decode()
        curses.noecho()
        curses.curs_set(0)
        return s.strip()

    def shell(fn, *a):
        curses.endwin()
        try:
            fn(*a)
        except SystemExit as e:
            print(e)
        input("\n[enter] ")
        scr.refresh()

    while True:
        if rows is None:
            scr.erase()
            scr.addstr(0, 1, "subs  loading...")
            scr.refresh()
            rows = status()
            sel = min(sel, max(len(rows) - 1, 0))
        lines, idx = table(rows)
        h, w = scr.getmaxyx()
        scr.erase()
        if h < 6 or w < 30:
            scr.addstr(0, 0, "subs: window too small"[:w - 1])
            if scr.getch() == ord("q"):
                return
            continue
        scr.addstr(0, 1, "subs", curses.A_BOLD)
        for y, (line, i) in enumerate(list(zip(lines, idx))[:h - 4], 2):
            if i is None:
                scr.addstr(y, 1, line[:w - 2], curses.A_DIM)
                continue
            r = rows[i]
            attr = (curses.A_REVERSE if i == sel else 0) | (curses.A_BOLD if r["active"] else 0)
            peak = max([p or 0 for _, p, _ in r.get("windows", [])] + [0])
            if r.get("err") or r.get("limited") or peak >= 90:
                attr |= curses.color_pair(3)
            elif peak >= 70:
                attr |= curses.color_pair(2)
            elif r["active"]:
                attr |= curses.color_pair(1)
            scr.addstr(y, 1, line[:w - 2].ljust(w - 2) if i == sel else line[:w - 2], attr)
        scr.addstr(h - 2, 1, (msg or HELP)[:w - 2], curses.A_DIM)
        msg = ""
        k = scr.getch()
        cur = rows[sel] if rows else None
        prov = PROVIDERS[cur["provider"]] if cur else None
        if k in (ord("q"), 27):
            return
        elif k in (ord("j"), curses.KEY_DOWN) and rows:
            sel = (sel + 1) % len(rows)
        elif k in (ord("k"), curses.KEY_UP) and rows:
            sel = (sel - 1) % len(rows)
        elif k == ord("r"):
            rows = None
        elif k in (10, 13, curses.KEY_ENTER) and cur:
            shell(use, prov, cur["email"])
            rows = None
        elif k == ord("l") and cur:
            shell(login, prov, cur["email"])
            rows = None
        elif k == ord("n"):
            name = ask("provider (codex/claude): ")
            if name in PROVIDERS:
                shell(login, PROVIDERS[name], ask("email (optional): ") or None)
                rows = None
            else:
                msg = "unknown provider"
        elif k == ord("a") and cur:
            pw = ask("password for %s: " % cur["email"], secret=True)
            if pw:
                store_password(prov, cur["email"], pw)
                cur["password"] = True
                msg = "password stored"
        elif k == ord("p") and cur:
            pw = password(prov, cur["email"])
            msg = ("copied" if pw and clip(pw) else pw or "no password stored")
        elif k == ord("d") and cur:
            if ask("forget %s %s? [y/N] " % (prov.name, cur["email"])).lower() == "y":
                rm(prov, cur["email"], say=lambda s: None)
                msg = "forgot " + cur["email"]
                rows = None


# --- main ------------------------------------------------------------------

def main(argv):
    os.umask(0o077)
    os.makedirs(STORE, mode=0o700, exist_ok=True)
    os.chmod(STORE, 0o700)  # it holds passwords and live tokens
    cmd = argv[0] if argv else "status"
    if cmd in ("-h", "--help", "help"):
        return print(__doc__.split("\n\n")[1])
    if cmd == "status":
        return cmd_status(argv)
    if cmd == "json":
        return cmd_json(argv)
    if cmd == "tui":
        return curses.wrapper(tui)
    args = [a for a in argv[1:] if not a.startswith("-")]
    if not args or args[0] not in PROVIDERS:
        sys.exit("usage: subs %s codex|claude EMAIL" % cmd)
    prov, email = PROVIDERS[args[0]], (args[1] if len(args) > 1 else None)
    if cmd == "login":
        return login(prov, email, "--use" in argv)
    if not email:
        sys.exit("usage: subs %s %s EMAIL" % (cmd, prov.name))
    fn = {"use": use, "add": add, "pass": show_password, "rm": rm}.get(cmd)
    if not fn:
        sys.exit("subs: unknown command %s (subs help)" % cmd)
    fn(prov, email)


if __name__ == "__main__":
    for sig in (signal.SIGTERM, signal.SIGHUP):  # run `finally` cleanups
        signal.signal(sig, lambda n, _: sys.exit(128 + n))
    try:
        main(sys.argv[1:])
    except KeyboardInterrupt:
        sys.exit(130)
